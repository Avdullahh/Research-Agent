{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research report",
  "description": "Contract between the agent (stage 4 synthesis) and render_report.py (stage 5).",
  "type": "object",
  "required": [
    "run_id",
    "generated_at",
    "topic",
    "role",
    "home_region",
    "depth",
    "theme",
    "executive_summary",
    "key_findings",
    "coverage_notes",
    "sources"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "title": {
      "type": "string",
      "description": "Optional short report title for the cover. Falls back to topic."
    },
    "topic": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "home_region": { "type": "string", "minLength": 1 },
    "subject_regions": { "type": "array", "items": { "type": "string" } },
    "depth": { "type": "string", "enum": ["brief", "standard"] },
    "theme": {
      "type": "string",
      "enum": ["academic", "regulatory", "market", "technical"]
    },
    "theme_rationale": {
      "type": "string",
      "description": "Why this theme was chosen, when theme was 'auto' in the brief."
    },
    "recency": { "type": "string" },
    "questions": {
      "type": "array",
      "description": "The brief's questions, echoed so the reader can check coverage.",
      "items": { "type": "string" }
    },
    "executive_summary": { "type": "string", "minLength": 1 },

    "key_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "body", "implication_for_role", "source_ids"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "implication_for_role": { "type": "string", "minLength": 1 },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Every finding must cite at least one source."
          },
          "answers_question": {
            "type": "string",
            "description": "Which of the brief's questions this finding addresses."
          },
          "confidence": { "type": "string", "enum": ["high", "moderate", "low"] }
        },
        "additionalProperties": false
      }
    },

    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "assessment"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "supporting_ids": { "type": "array", "items": { "type": "string" } },
          "contradicting_ids": { "type": "array", "items": { "type": "string" } },
          "assessment": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },

    "coverage_notes": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory. Gaps, thin local coverage, unreachable must_include sources, unanswered questions. Vague hedging is worse than nothing."
    },

    "excluded_sources": {
      "type": "array",
      "description": "Candidates dropped during vetting, so absence is visibly a decision.",
      "items": {
        "type": "object",
        "required": ["url", "reason"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "tier",
          "rationale",
          "publisher_jurisdiction",
          "proximity_tier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Short citation key referenced by key_findings.source_ids, e.g. 'S1'."
          },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "author": { "type": ["string", "null"] },
          "published_date": { "type": ["string", "null"] },
          "accessed_date": { "type": ["string", "null"] },
          "tier": {
            "type": "string",
            "enum": ["A", "B", "C"],
            "description": "A primary/authoritative, B credible secondary, C context only."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Why this source cleared the bar, and which brief guideline it satisfied."
          },
          "publisher_jurisdiction": { "type": "string", "minLength": 1 },
          "subject_regions": { "type": "array", "items": { "type": "string" } },
          "proximity_tier": {
            "type": "string",
            "enum": ["local", "regional", "global"]
          },
          "caveat": {
            "type": ["string", "null"],
            "description": "Commercial interest, partial access, paywalled abstract only, etc."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
